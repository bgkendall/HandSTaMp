			)
			(table_cell "RGB"
				(exclude_from_sim no)
				(at 78.74 171.45 0)
				(size 6.35 3.81)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
				)
				(uuid "94d30c0d-c5b7-4d00-8471-35fce79fe585")
			)
			(table_cell "The “RGB” pin, PB1, has the following timer available to support PWM with DMA: TIM3_CH4"
				(exclude_from_sim no)
				(at 85.09 171.45 0)
				(size 87.63 3.81)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
					(justify left)
				)
				(uuid "c4094648-2b79-4f6c-a2b1-b74222050ea3")
			)
			(table_cell "PC×"
				(exclude_from_sim no)
				(at 78.74 175.26 0)
				(size 6.35 6.35)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
				)
				(uuid "6a948256-8fcd-4d05-910a-c60ff1ca29bf")
			)
			(table_cell "Other STM32 models have limitations on PC13, PC14 and PC15 because these are supplied through the VBAT power switch. The C071 chips do not have a VBAT power switch and so do not have this limitation."
				(exclude_from_sim no)
				(at 85.09 175.26 0)
				(size 87.63 6.35)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
					(justify left)
				)
				(uuid "443bb4e3-95b4-46ae-8fae-5de14a8e329c")
			)
			(table_cell "SWD"
				(exclude_from_sim no)
				(at 78.74 181.61 0)
				(size 6.35 3.81)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
					(justify left)
				)
				(uuid "d1304e19-ba7d-48dc-830b-904cbae6a253")
			)
			(table_cell "It may be possible to use this pin, PA14, as additional I/O."
				(exclude_from_sim no)
				(at 85.09 181.61 0)
				(size 87.63 3.81)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
					(justify left)
				)
				(uuid "325a3202-427f-479f-8c60-a72f35074058")
			)
			(table_cell "PF2"
				(exclude_from_sim no)
				(at 78.74 185.42 0)
				(size 6.35 10.16)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
				)
				(uuid "85ffc9a8-aa97-413b-8322-79e3d793ed8a")
			)
			(table_cell "PF2-NRST can be be used as additional I/O by setting the NRST_MODE option bits appropriately.\nNote that even in I/O mode the NRST pin must be able to be pulled high on power-on, otherwise the MCU will not start."
				(exclude_from_sim no)
				(at 85.09 185.42 0)
				(size 87.63 10.16)
				(margins 0.9525 0.9525 0.9525 0.9525)
				(span 1 1)
				(fill
					(type none)
				)
				(effects
					(font
						(size 1.27 1.27)
					)
					(justify left)
				)
				(uuid "32703c8c-ba1c-46d9-8618-af6e8ed41ee9")
			)
		)
	)
